rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ========================================
    // THEME COVER IMAGES (Public Read)
    // Cover images for theme collections
    // ========================================
    match /themes/{imageFile} {
      allow read: if true; // PUBLIC: Theme covers are public assets
      allow write: if false; // Admin only via console
    }

    // ========================================
    // HERITAGE RECIPE IMAGES (Public Read)
    // Original heritage collection images
    // ========================================
    match /heritage-recipes/{imageFile} {
      allow read: if true; // PUBLIC: Heritage images are public assets
      allow write: if false; // Admin only via console
    }

    // ========================================
    // THEME RECIPE IMAGES (Public Read)
    // Recipe images organized by theme
    // ========================================
    match /recipes/{themeId}/{imageFile} {
      allow read: if true; // PUBLIC: Recipe images are public assets
      allow write: if false; // Admin only via console
    }

    // ========================================
    // RECIPE IMAGES (Public CDN)
    // Public recipe images for CDN caching
    // ========================================
    match /recipe-images/{recipeId}/{imageFile} {
      allow read: if true; // Public read (CDN-cached)
      allow write: if false; // Server only
    }

    // ========================================
    // USER RECIPE IMAGES (User-Scoped)
    // User-owned recipe images for Firebase sync
    //
    // NOTE: Storage Rules cannot query Firestore to check sharing permissions.
    // Images are readable by all authenticated users to enable recipe sharing.
    // Security is enforced by:
    // 1. Recipe image paths contain recipe UUIDs (unguessable)
    // 2. Users need the share link to know the image path
    // 3. Only authenticated users can read
    // ========================================
    match /users/{userId}/recipes/{recipeId}/{imageFile} {
      // Authenticated users can read recipe images (for sharing)
      // Image paths contain UUIDs, preventing enumeration
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================
    // USER AVATARS (Social Layer)
    // Profile avatars for social features
    // Stored as: users/{userId}/profile/avatar.jpg
    // ========================================
    match /users/{userId}/profile/{fileName} {
      // Public read - avatars are shown to connections and in lineage views
      allow read: if true;
      // Only owner can upload/update their avatar
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================
    // OG PROFILE IMAGES (Social Layer)
    // Generated profile cards for link previews
    // Stored as: og-images/profiles/{userId}/{filename}
    // ========================================
    match /og-images/profiles/{userId}/{fileName} {
      // Public read - these are used for social media previews
      allow read: if true;
      // Server only (Cloud Function generates these)
      allow write: if false;
    }

    // ========================================
    // PUBLIC RECIPE IMAGES (Public Discovery)
    // Images for recipes published to public discovery
    // Stored as: publicRecipes/{recipeId}/image.jpg
    // ========================================
    match /publicRecipes/{recipeId}/{imageFile} {
      // Public read - these are community-shared recipes
      allow read: if true;
      // Only authenticated users can upload (when publishing)
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ========================================
    // IMPORT CACHE (Server Only)
    // Temporary cache for URL imports
    // ========================================
    match /import-cache/{urlHash}/{file} {
      allow read, write: if false; // Server only
    }

    // ========================================
    // TEMPORARY UPLOADS (User-Scoped)
    // Temporary storage for user uploads
    // ========================================
    match /temp-uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================
    // FALLBACK: Deny all other access
    // ========================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
