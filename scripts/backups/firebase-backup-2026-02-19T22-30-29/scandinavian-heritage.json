    {
      "id": "scandinavian-heritage-004",
      "title": "Danish Roast Pork with Crackling (Flæskesteg)",
      "description": "Succulent pork roast with impossibly crispy skin—the centerpiece of Danish celebrations.",
      "prepTime": 20,
      "cookTime": 150,
      "servings": 8,
      "source": "Danish-American immigrant tradition",
      "story": "Flæskesteg is the star of Danish Christmas dinner. The crackling (svær) must be absolutely crispy—Danes take this very seriously. Drying the skin overnight is the secret.",
