# Firebase (uses service account from parent dir)
GOOGLE_APPLICATION_CREDENTIALS=../../service-account-key.json
FIREBASE_STORAGE_BUCKET=heirloom-ios-prod.firebasestorage.app

# Note: REPLICATE_API_TOKEN is fetched from Google Secret Manager
# It uses the same secret as Cloud Functions (set via: firebase functions:secrets:set REPLICATE_API_TOKEN)
# No local configuration needed - just ensure service account has Secret Manager access
