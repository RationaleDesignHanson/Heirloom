#!/bin/bash

# Heirloom Pre-Commit Hook
# Checks for common issues before allowing commits

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

FAILED=0

# Get list of staged Swift files
SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.swift$")

if [ -z "$SWIFT_FILES" ]; then
    echo -e "${GREEN}✓${NC} No Swift files to check"
    exit 0
fi

# Check 1: Debug print statements
echo "Checking for debug print statements..."
if echo "$SWIFT_FILES" | xargs grep -n "print(" 2>/dev/null; then
    echo -e "${YELLOW}⚠${NC} Warning: Found print() statements. Consider using Log instead."
    echo "  Use: Log.debug(), Log.info(), Log.warning(), or Log.error()"
fi

# Check 2: Hardcoded API keys or secrets
echo "Checking for hardcoded secrets..."
if echo "$SWIFT_FILES" | xargs grep -iE "(api[_-]?key|secret|password|token)\s*=\s*\"[^\"]{10,}\"" 2>/dev/null; then
    echo -e "${RED}✗${NC} Error: Potential hardcoded secrets found!"
    echo "  API keys should be in Config.xcconfig, not in code."
    FAILED=1
fi

# Check 3: Force unwrapping (optional warning, not blocking)
FORCE_UNWRAP_COUNT=$(echo "$SWIFT_FILES" | xargs grep -c "!" 2>/dev/null | awk -F: '{sum+=$2} END {print sum}')
if [ "$FORCE_UNWRAP_COUNT" -gt 10 ]; then
    echo -e "${YELLOW}⚠${NC} Warning: $FORCE_UNWRAP_COUNT force unwraps found in staged files."
    echo "  Consider using optional binding (if let / guard let) instead."
fi

# Check 4: File size check (warn on very large files)
echo "Checking file sizes..."
for file in $SWIFT_FILES; do
    SIZE=$(wc -l < "$file" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt 500 ]; then
        echo -e "${YELLOW}⚠${NC} Warning: $file has $SIZE lines (consider refactoring if >500 lines)"
    fi
done

# Check 5: Syntax check (Swift compiler)
# Skip test files - they use @testable import which requires the module to be built
# Xcode build and CI will catch syntax errors in test files
echo "Running Swift syntax check..."
for file in $SWIFT_FILES; do
    # Skip test files (swiftc can't resolve @testable import outside Xcode)
    if [[ "$file" == *"Tests"* ]] || grep -q "@testable import" "$file" 2>/dev/null; then
        continue
    fi
    if ! swiftc -syntax "$file" > /dev/null 2>&1; then
        echo -e "${RED}✗${NC} Syntax error in: $file"
        FAILED=1
    fi
done

# Check 6: Verify no Config.xcconfig being committed
if git diff --cached --name-only | grep -q "Config.xcconfig"; then
    echo -e "${RED}✗${NC} Error: Config.xcconfig should not be committed (contains secrets)"
    echo "  Run: git reset HEAD Config.xcconfig"
    FAILED=1
fi

# Summary
echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}✗ Pre-commit checks failed${NC}"
    echo "Fix the errors above or use 'git commit --no-verify' to skip checks."
    exit 1
else
    echo -e "${GREEN}✓ All pre-commit checks passed${NC}"
    exit 0
fi
