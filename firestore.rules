rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if a user ID is a demo user (for TestFlight demo social features)
    function isDemoUser(userId) {
      return userId.matches('demo_.*');
    }

    // ========================================
    // HELPER FUNCTIONS FOR RECIPE ACCESS
    // ========================================

    // Recipe read access is restricted to:
    // 1. Recipe owner
    // 2. Users connected to the owner (via isConnectedTo helper)
    // 3. Demo users (for TestFlight experience)
    //
    // Share preview for non-connected recipients uses /shares/{shareId} metadata
    // (publicly readable). Full recipe copy happens at acceptance via app logic.

    // ========================================
    // USER DOCUMENT (Parent Document)
    // Allows users to delete their own user document during account deletion
    // ========================================
    match /users/{userId} {
      // Users can read their own document
      allow read: if isOwner(userId);

      // Users can create their own document
      allow create: if isOwner(userId);

      // Users can update their own document
      allow update: if isOwner(userId);

      // Users can delete their own document (for account deletion)
      allow delete: if isOwner(userId);
    }

    // ========================================
    // USER RECIPES (User-Scoped)
    // ========================================
    match /users/{userId}/recipes/{recipeId} {
      // Owner, connected users, or demo users can read recipes
      // Share preview for non-connected recipients uses /shares/{shareId} metadata (publicly readable)
      // Write access is still restricted to owners only
      allow read: if isOwner(userId) ||
                     (isAuthenticated() && isConnectedTo(userId)) ||
                     (isAuthenticated() && isDemoUser(userId));

      // Users can create their own recipes
      // Exception: Any authenticated user can create recipes for demo users (TestFlight demo experience)
      allow create: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));

      // Users can update their own recipes
      // Exception: Any authenticated user can update demo user recipes (TestFlight demo experience)
      allow update: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));

      // Users can delete their own recipes
      // Exception: Any authenticated user can delete demo user recipes (TestFlight demo experience)
      allow delete: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));

      // Ingredients subcollection
      match /ingredients/{ingredientId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));
      }

      // Instructions subcollection
      match /instructions/{instructionId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));
      }

      // Card back subcollection
      match /cardBack/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));
      }

      // Operations subcollection (for CRDT)
      match /operations/{operationId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));
      }
    }

    // ========================================
    // RECIPE SHARES (User-Scoped)
    // ========================================
    match /users/{userId}/recipeShares/{shareId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ========================================
    // RECIPE VERSIONS (User-Scoped)
    // ========================================
    match /users/{userId}/recipeVersions/{versionId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ========================================
    // SHARES (Top-Level)
    // ========================================
    match /shares/{shareId} {
      // Anyone with link can read (no authentication required)
      // This allows share recipients to view share metadata before accepting
      // Share IDs are UUIDs and not guessable, so this is secure
      allow read: if true;

      // Only owner can create shares, with proper validation
      // Exception: Demo shares can be created by any authenticated user when ownerId is a demo user
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['shareId', 'recipeId', 'ownerId', 'ownerName']) &&
                       (
                         // Normal shares: user must be the owner
                         request.auth.uid == request.resource.data.ownerId ||
                         // Demo shares: allow if the owner is a demo user (server-side UID check)
                         isDemoUser(request.resource.data.ownerId)
                       );

      // Restricted update: Owner can update all fields OR recipient can add themselves to acceptedBy OR anyone can increment viewCount
      allow update: if isAuthenticated() && (
        // Owner can update any fields
        request.auth.uid == resource.data.ownerId ||

        // Anyone can increment viewCount for analytics (share preview tracking)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
          request.resource.data.viewCount > resource.data.viewCount
        ) ||

        // Recipient can add themselves to acceptedBy and update acceptance counters
        (
          // Verify user is adding themselves to acceptedBy
          request.resource.data.acceptedBy is list &&
          request.resource.data.acceptedBy.hasAll(resource.data.acceptedBy) &&  // All previous users still there
          (request.auth.uid in request.resource.data.acceptedBy) &&              // Current user is now in the list
          !(request.auth.uid in resource.data.acceptedBy)                        // Current user was NOT in the list before

          // Recipients can update acceptCount and lastAcceptedAt during acceptance
          // No additional validation needed - these are controlled by the app
        )
      );

      // Owner can delete, OR recipients can delete demo/welcome shares (for reset cleanup)
      allow delete: if isAuthenticated() &&
                       (request.auth.uid == resource.data.ownerId ||
                        (request.auth.uid in resource.data.recipientUserIds &&
                         isDemoUser(resource.data.ownerId)));
    }

    // ========================================
    // USER LINEAGES (User-Scoped)
    // ========================================
    match /users/{userId}/lineages/{lineageId} {
      // Users can read their own lineages
      allow read: if isOwner(userId);

      // Users can write their own lineages
      // Exception: Any authenticated user can write demo user lineages (TestFlight demo experience)
      allow write: if isOwner(userId) || (isAuthenticated() && isDemoUser(userId));
    }

    // ========================================
    // LINEAGES INDEX (Top-Level - for querying across users)
    // ========================================
    match /lineages/{lineageId} {
      // Any authenticated user can read (for querying family trees)
      allow read: if isAuthenticated();

      // Only owner can create lineages
      // Exception: Any authenticated user can create lineages for demo users (TestFlight demo experience)
      allow create: if isAuthenticated() &&
                       (request.auth.uid == request.resource.data.ownerId ||
                        isDemoUser(request.resource.data.ownerId));

      // Only owner can update lineages
      // Exception: Any authenticated user can update demo user lineages (TestFlight demo experience)
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.ownerId ||
                        isDemoUser(resource.data.ownerId));

      // Only owner can delete lineages
      // Exception: Any authenticated user can delete demo user lineages (TestFlight demo experience)
      allow delete: if isAuthenticated() &&
                       (request.auth.uid == resource.data.ownerId ||
                        isDemoUser(resource.data.ownerId));
    }

    // ========================================
    // USER NOTIFICATIONS (Extended for Social)
    // ========================================
    match /users/{userId}/notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(userId);

      // Notification creation requires sender validation and a relationship
      // - Own inbox: allowed (for demo flow where user creates demo notifications)
      // - Other users: sender field must match auth.uid AND must be connected,
      //   except connection requests (pre-connection) and lineage mods (cross-lineage chain)
      allow create: if isAuthenticated() && (
        // Users can create notifications in their own inbox (demo flow)
        isOwner(userId) ||
        // For other users' inboxes: validate sender AND check relationship
        (
          // Sender must identify themselves truthfully (prevents impersonation)
          (request.resource.data.get('actorUserId', null) == request.auth.uid ||
           request.resource.data.get('modifiedBy', null) == request.auth.uid) &&
          // Must be connected, or sending a pre-connection/cross-lineage notification
          (isConnectedTo(userId) ||
           request.resource.data.type == 'connectionRequestReceived' ||
           request.resource.data.type == 'lineage_modification')
        )
      );

      // Users can update their own (mark as read)
      allow update: if isOwner(userId);

      // Users can delete their own notifications
      allow delete: if isOwner(userId);
    }

    // ========================================
    // USER PROFILES (Top-Level - Legacy)
    // For display names in version history
    // ========================================
    match /userProfiles/{userId} {
      // Any authenticated user can read profiles (for display names in version history)
      // This is read-only access to displayName and email fields
      allow read: if isAuthenticated();

      // Only owner can create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Only owner can delete their profile
      allow delete: if isOwner(userId);
    }

    // ========================================
    // USER COLLECTIONS (User-Scoped)
    // ========================================
    match /users/{userId}/collections/{collectionId} {
      // Users can read their own collections
      allow read: if isOwner(userId);

      // Users can write their own collections
      allow write: if isOwner(userId);
    }

    // ========================================
    // RESTYLE JOBS (User-Scoped)
    // Batch image restyle job tracking
    // Stored at: users/{userId}/restyleJobs/{jobId}
    // ========================================
    match /users/{userId}/restyleJobs/{jobId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ========================================
    // USER CREDITS (User-Scoped)
    // Credit balance for restyle and other paid features
    // Stored at: users/{userId}/credits/{document}
    // ========================================
    match /users/{userId}/credits/{document} {
      allow read: if isOwner(userId);
      // Write managed by Cloud Functions (credit purchase, deduction, refund)
      allow write: if false;
    }

    // ========================================
    // THEME STATE (User-Scoped)
    // Tracks user theme selection and unlock progress
    // ========================================
    match /users/{userId}/themeState/{document=**} {
      // Users can read their own theme state
      allow read: if isOwner(userId);

      // Users can write their own theme state
      allow write: if isOwner(userId);
    }

    // ========================================
    // THEMES (Top-Level - Read-Only)
    // Curated recipe themes for discovery
    // ========================================
    match /themes/{themeId} {
      // Any authenticated user can read themes
      allow read: if isAuthenticated();

      // Only admins can write (via Firebase console/functions)
      allow write: if false;

      // Theme recipes (subcollection)
      match /recipes/{recipeId} {
        // Any authenticated user can read theme recipes
        allow read: if isAuthenticated();

        // Only admins can write
        allow write: if false;

        // Ingredients subcollection
        match /ingredients/{ingredientId} {
          allow read: if isAuthenticated();
          allow write: if false;
        }

        // Instructions subcollection
        match /instructions/{instructionId} {
          allow read: if isAuthenticated();
          allow write: if false;
        }
      }
    }

    // ========================================
    // ========================================
    // SOCIAL LAYER COLLECTIONS (Phase 3-6)
    // ========================================
    // ========================================

    // ========================================
    // HELPER FUNCTIONS FOR PROFILE ACCESS
    // ========================================

    // Check if users are connected
    function isConnectedTo(userId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/connections/$(userId)) ||
             exists(/databases/$(database)/documents/users/$(userId)/connections/$(request.auth.uid));
    }

    // ========================================
    // USER PROFILES (Social Layer - User-Scoped)
    // **CRITICAL PATH** for ProfileService
    // Stored at: users/{userId}/profile/data
    // ========================================
    match /users/{userId}/profile/{document=**} {
      // Users can read profiles if they:
      // 1. Own the profile
      // 2. Are connected to the profile owner
      // 3. Need to check handle availability (limited to just the 'data' document for collectionGroup queries)
      // For handle availability, we allow read access but the app should only query specific fields
      allow read: if isOwner(userId) ||
                     isConnectedTo(userId) ||
                     // Allow limited read for handle availability checks (collectionGroup queries)
                     (isAuthenticated() && document == 'data');

      // Users can create/update their own profile
      allow write: if isOwner(userId);
    }

    // ========================================
    // PROFILE COLLECTION GROUP (for search queries)
    // Explicit rule for collectionGroup("profile") queries
    // ========================================
    match /{path=**}/profile/{document} {
      // Any authenticated user can read profile documents via collection group queries
      allow read: if isAuthenticated();
    }

    // ========================================
    // PUBLIC PROFILES (Social Layer - Top-Level)
    // For shareable profile URLs
    // Stored at: publicProfiles/{slug}
    // ========================================
    match /publicProfiles/{slug} {
      // Anyone authenticated can read public profiles
      // (used for profile link previews and discovery)
      allow read: if isAuthenticated();

      // Only the profile owner can create/update their public profile
      // Verified by checking userId in the document matches auth.uid
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;

      // Only owner can delete
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // ========================================
    // USER CONNECTIONS (Social Layer - User-Scoped)
    // For bidirectional connections
    // Stored at: users/{userId}/connections/{connectionId}
    // ========================================
    match /users/{userId}/connections/{connectionId} {
      // Users can read their own connections OR connections where they are the connectedUserId
      // This allows User A to query User B's connections to check for existing connections
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId ||
                      request.auth.uid == resource.data.connectedUserId);

      // Any authenticated user can create connections in ANY user's collection
      // IF the connection is between the authenticated user and that collection owner
      // This allows User A to create connection docs in both:
      // - users/A/connections/{id} (where connectedUserId = B)
      // - users/B/connections/{id} (where connectedUserId = A)
      // Exception: Demo connections allowed when either party is a demo user (server-side UID check)
      allow create: if isAuthenticated() &&
                       (request.auth.uid == userId ||
                        request.auth.uid == request.resource.data.connectedUserId ||
                        isDemoUser(userId) || isDemoUser(request.resource.data.connectedUserId));

      // Users can update their own connections or connections where they are the connected user
      // (for accepting requests, updating status, adding notes)
      // Exception: Demo connections can be updated when either party is a demo user (server-side UID check)
      allow update: if isAuthenticated() &&
                       (request.auth.uid == userId ||
                        request.auth.uid == resource.data.connectedUserId ||
                        isDemoUser(userId) || isDemoUser(resource.data.connectedUserId));

      // Users can delete their own connections OR connections where they are the connectedUserId
      // This allows User A to delete reciprocal connection from User B's collection
      allow delete: if isAuthenticated() &&
                       (request.auth.uid == userId ||
                        request.auth.uid == resource.data.connectedUserId);
    }

    // ========================================
    // KITCHEN TABLES (Social Layer - Top-Level)
    // For cooking groups/circles
    // Stored at: kitchenTables/{tableId}
    // ========================================
    match /kitchenTables/{tableId} {
      // Any authenticated user can read kitchen tables they're a member of
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.memberIds;

      // Any authenticated user can create a kitchen table
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId;

      // Members can update (for invites, member management)
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.ownerId ||
                        request.auth.uid in resource.data.memberIds);

      // Only owner can delete
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // USER SETTINGS (Privacy & Preferences)
    // Stored at: users/{userId}/settings/{document}
    // ========================================
    match /users/{userId}/settings/{document} {
      // Users can only read their own settings
      allow read: if isOwner(userId);

      // Users can only write their own settings
      allow write: if isOwner(userId);
    }

    // ========================================
    // USER TAGS (User-Scoped)
    // Stored at: users/{userId}/tags/{tagId}
    // ========================================
    match /users/{userId}/tags/{tagId} {
      // Users can read and write their own tags
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Any authenticated user can read tags (for sharing)
      allow read: if isAuthenticated();
    }

    // ========================================
    // USER SHOPPING CART (User-Scoped)
    // Stored at: users/{userId}/shoppingCart/{cartRecipeId}
    // ========================================
    match /users/{userId}/shoppingCart/{cartRecipeId} {
      // Users can read and write their own shopping cart
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Any authenticated user can read cart (for sharing)
      allow read: if isAuthenticated();
    }

    // ========================================
    // USER DINNER PARTIES (User-Scoped)
    // Stored at: users/{userId}/dinnerParties/{partyId}
    // ========================================
    match /users/{userId}/dinnerParties/{partyId} {
      // Users can read and write their own dinner parties
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Any authenticated user can read parties (for sharing)
      allow read: if isAuthenticated();
    }

    // ========================================
    // PUBLIC RECIPES (Phase 11 - Public Discovery)
    // For community recipe discovery
    // Stored at: publicRecipes/{publicRecipeId}
    // ========================================
    match /publicRecipes/{recipeId} {
      // Anyone can read public recipes (no authentication required for discovery)
      allow read: if true;

      // Only authenticated users can publish recipes
      // Must set ownerId to match their auth.uid (prevents impersonation)
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid;

      // Only the recipe owner can update their public recipe
      allow update: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;

      // Only the recipe owner can delete (unpublish) their public recipe
      allow delete: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;
    }

    // ========================================
    // PUBLIC RECIPE REPORTS (Phase 11 - Moderation)
    // For reporting inappropriate public recipes
    // Stored at: publicRecipeReports/{reportId}
    // ========================================
    match /publicRecipeReports/{reportId} {
      // Users can read their own reports (to check if already reported)
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.reporterId ||
                      request.auth.uid == resource.data.reviewedBy);

      // Any authenticated user can create reports
      // Reporter ID must match auth user
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.reporterId &&
                       request.resource.data.status == 'pending';

      // Only moderators/admins can update (via Cloud Functions)
      allow update: if false;

      // Only moderators/admins can delete (via Cloud Functions)
      allow delete: if false;
    }

    // ========================================
    // SOURCE CATALOG (Crowdsourced Source Registry)
    // Shared catalog of recipe sources (websites, cookbooks, creators)
    // Stored at: source_catalog/{sourceId}
    // ========================================
    match /source_catalog/{sourceId} {
      // Any authenticated user can read the catalog
      allow read: if isAuthenticated();

      // Any authenticated user can contribute to the catalog
      allow create: if isAuthenticated();

      // Any authenticated user can update (increment counts, add aliases)
      allow update: if isAuthenticated();

      // No deletion (catalog entries are permanent)
      allow delete: if false;
    }

    // ========================================
    // FALLBACK: Deny all other access
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
