    {
      "id": "american-foundation-001",
      "title": "Colonial Brown Bread",
      "description": "One cup Indian meal, one cup rye meal, one cup graham flour, three-quarters cup molasses, two cups sour milk, two teaspoons salt, two teaspoons soda. Steam three hours.",
      "prepTime": "15 minutes",
      "cookTime": "3 hours (steaming)",
      "servings": "Makes 2 loaves",
      "difficulty": "medium",
      "unlockDay": 1,
      "sortOrder": 1,
      "tags": [
        "bread",
        "colonial",
        "New England"
      ],
      "source": "Colonial New England kitchens, Fannie Farmer's Boston Cooking-School Cook Book",
      "story": "Boston Brown Bread was a staple of colonial New England, developed when wheat was scarce and settlers relied on native corn (maize) and imported rye. Traditionally steamed in special cylindrical molds on Saturday and served with baked beans for Sunday dinner (as cooking on the Sabbath was prohibited). The three types of flour represent the agricultural diversity of colonial America.",
      "ingredients": [
        {
          "name": "1 cup rye meal"
        },
        {
          "name": "1 cup Indian meal (cornmeal)"
        },
        {
          "name": "1 cup graham flour"
        },
        {
          "name": "3/4 cup molasses"
        },
        {
          "name": "2 cups sour milk or buttermilk"
        },
        {
          "name": "2 tsp salt"
        },
        {
          "name": "2 tsp baking soda"
        },
        {
          "name": "1 cup raisins (optional)"
        }
      ],
      "instructions": [
        "Mix all dry ingredients in a large bowl.",
        "Stir in molasses and sour milk.",
        "Add raisins if desired.",
        "Pour into greased pudding molds or coffee cans, filling 2/3 full.",
        "Cover tightly with lids or cloth.",
        "Steam for 3 hours in a large pot with water halfway up the molds.",
        "Cool slightly before unmolding.",
        "Slice and serve warm with butter."
      ]
    },
    {
      "id": "american-foundation-002",
      "title": "Shaker Lemon Pie",
      "description": "Slice two lemons as thin as paper, rind and all. Place in a bowl with two cups sugar, mix well and let stand over night or for 24 hours. Then add four well beaten eggs. Pour into a crust-lined pie plate, arrange lemon slices evenly. Cover with top crust, cut several slits near center. Bake in hot oven 15 minutes, reduce heat and bake 30 minutes more or until silver knife inserted comes out clean.",
      "prepTime": "24 hours (for maceration)",
      "cookTime": "45 minutes",
      "servings": "Serves 8",
      "difficulty": "medium",
      "unlockDay": 1,
      "sortOrder": 2,
      "tags": [
        "dessert",
        "pie",
        "Shaker",
        "lemon"
      ],
      "source": "Shaker community records, North Union Shaker Village",
      "story": "This ingenious recipe from the Ohio Shaker community (circa 1800s) demonstrates the sect's commitment to simplicity and waste reduction—the entire lemon, rind and all, is used. The Shakers were known for their innovative agricultural and culinary practices. This pie became a symbol of American resourcefulness and Shaker perfectionism, where economy met elegance.",
      "ingredients": [
        {
          "name": "2 whole lemons, washed"
        },
        {
          "name": "2 cups sugar"
        },
        {
          "name": "4 eggs, well beaten"
        },
        {
          "name": "Pastry for 9-inch double crust pie"
        },
        {
          "name": "1/4 tsp salt"
        }
      ],
      "instructions": [
        "Slice lemons paper-thin, removing seeds.",
        "Combine lemon slices with sugar in a bowl.",
        "Let stand 24 hours, stirring occasionally.",
        "Add beaten eggs and salt to lemon mixture.",
        "Line pie pan with bottom crust.",
        "Pour filling into crust, spreading evenly.",
        "Cover with top crust, seal edges, and cut vents.",
        "Bake at 450°F for 15 minutes, then at 375°F for 30 minutes.",
        "Cool completely before serving."
      ]
    },
