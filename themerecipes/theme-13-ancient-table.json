    {
      "id": "ancient-table-001",
      "title": "Apicius' Conditum Paradoxum",
      "description": "Melt honey in wine with pepper, bay leaves, saffron and dates. When warmed, pour into vessels for aging. The older it gets, the better it becomes.",
      "prepTime": "15 minutes",
      "cookTime": "10 minutes (plus aging)",
      "servings": "Makes 1 amphora (about 6 bottles)",
      "difficulty": "medium",
      "unlockDay": 1,
      "sortOrder": 1,
      "tags": [
        "beverage",
        "spiced wine",
        "Roman"
      ],
      "source": "Apicius, De Re Coquinaria",
      "story": "This spiced wine from Apicius' 'De Re Coquinaria' (circa 4th century CE) was served at Roman banquets. The recipe showcases the Roman love of complex flavors and expensive spices. 'Paradoxum' means 'special' or 'paradoxical,' likely referring to its unique combination of sweet honey, aromatic spices, and pungent pepper. It was considered both a digestive aid and a symbol of wealth.",
      "ingredients": [
        {
          "name": "1 gallon honey wine"
        },
        {
          "name": "15 g black pepper"
        },
        {
          "name": "4 bay leaves"
        },
        {
          "name": "2 g saffron"
        },
        {
          "name": "5 dates, pitted"
        },
        {
          "name": "Additional honey to taste"
        }
      ],
      "instructions": [
        "Combine honey wine with pepper, bay leaves, and saffron in a pot.",
        "Heat gently, but do not boil.",
        "Add pitted dates.",
        "Strain through a cloth.",
        "Store in sealed vessels.",
        "Age for at least one month before serving."
      ]
    },
    {
      "id": "ancient-table-002",
      "title": "Roman Patina de Piris",
      "description": "Patina de piris: pira elixa et purgata e medio teres cum pipere, cumino, melle, passo, liquamine et oleo modico. Ovis missis, in cumana facies, piper supra aspargis et inferes.",
      "prepTime": "30 minutes",
      "cookTime": "45 minutes",
      "servings": "Serves 6",
      "difficulty": "medium",
      "unlockDay": 1,
      "sortOrder": 2,
      "tags": [
        "dessert",
        "fruit",
        "Roman",
        "custard"
      ],
      "source": "Apicius, De Re Coquinaria, Book IV",
      "story": "Patina (the origin of our word 'pan') was a Roman custard-style dish, both savory and sweet. This pear patina from Apicius demonstrates Roman sophistication in combining fruits, spices, and dairy. The use of passum (raisin wine) and exotic spices like cumin shows the extensive trade networks of the Roman Empire. It was likely served as part of the secunda mensa (second course) at elaborate dinners.",
      "ingredients": [
        {
          "name": "6 pears, peeled and cored"
        },
        {
          "name": "1/2 cup honey"
        },
        {
          "name": "1/2 cup passum (or sweet wine)"
        },
        {
          "name": "1 tsp cumin"
        },
        {
          "name": "4 eggs"
        },
        {
          "name": "2 cups milk"
        },
        {
          "name": "Pepper and lovage to taste"
        },
        {
          "name": "Olive oil for greasing"
        }
      ],
      "instructions": [
        "Poach the pears in honey and passum until tender.",
        "Grind pepper, cumin, and lovage together.",
        "Beat eggs with milk.",
        "Add spices to egg mixture.",
        "Arrange pears in an oiled dish.",
        "Pour egg mixture over pears.",
        "Bake in a moderate oven until set.",
        "Serve warm with the poaching liquid drizzled over."
      ]
    },
