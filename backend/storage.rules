rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Recipe images - readable by all, writable by server only
    match /recipe-images/{recipeId}/{imageFile} {
      allow read: if true; // Public read (CDN-cached)
      allow write: if false; // Only server can write
    }

    // Import cache - server only
    match /import-cache/{urlHash}/{file} {
      allow read, write: if false; // Server only
    }

    // User uploads (temporary) - authenticated users only
    match /temp-uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
