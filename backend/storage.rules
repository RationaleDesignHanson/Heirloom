rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Recipe images - readable by all, writable by server only
    match /recipe-images/{recipeId}/{imageFile} {
      allow read: if true; // Public read (CDN-cached)
      allow write: if false; // Only server can write
    }

    // User recipe images - user-scoped storage (for Firebase sync)
    match /users/{userId}/recipes/{recipeId}/{imageFile} {
      allow read: if request.auth != null; // Any authenticated user (for sharing)
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Public recipe images (Phase 11: Public Discovery)
    match /publicRecipes/{recipeId}/{imageFile} {
      allow read: if true; // Anyone can read public recipe images
      allow write: if request.auth != null; // Authenticated users can upload when publishing
      allow delete: if request.auth != null; // Authors can delete when unpublishing
    }

    // Import cache - server only
    match /import-cache/{urlHash}/{file} {
      allow read, write: if false; // Server only
    }

    // User uploads (temporary) - authenticated users only
    match /temp-uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
