rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    // Updated: 2026-01-02 - Added operations subcollection for CRDT support
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Import attempts - Cloud Functions only can write, users can read their own
    // Cloud Functions with Admin SDK bypass these rules entirely
    match /import_attempts/{attemptId} {
      allow create: if false; // Only Cloud Functions can create
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid);
      allow update: if false; // Only Cloud Functions can update (for feedback)
      allow delete: if false; // Never delete (analytics data)
    }

    // Site patterns - read-only for clients, writable by server
    match /site_patterns/{domain} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server can write
    }

    // Training queue - admin only
    match /training_queue/{queueId} {
      allow read, write: if false; // Admin only via Firebase console
    }

    // User feedback - writable by owner
    match /user_feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    // Short URLs - server-managed, readable by anyone
    match /short_urls/{code} {
      allow read: if true; // Public read for redirects
      allow create: if false; // Only server can create
      allow update: if false; // Only server can update (click tracking)
      allow delete: if false; // Only server can delete
    }

    // URL clicks - server-only tracking
    match /url_clicks/{clickId} {
      allow read, write: if false; // Server-only analytics data
    }

    // ========================================
    // USER RECIPES (User-Scoped)
    // ========================================
    match /users/{userId}/recipes/{recipeId} {
      // Any authenticated user can read recipes (for accepting shares)
      // Shares are access-controlled via share IDs
      allow read: if isAuthenticated();

      // Users can create their own recipes
      allow create: if isOwner(userId);

      // Users can update their own recipes
      allow update: if isOwner(userId);

      // Users can delete their own recipes
      allow delete: if isOwner(userId);

      // Ingredients subcollection
      match /ingredients/{ingredientId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Card back subcollection
      match /cardBack/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Operations subcollection (for CRDT)
      match /operations/{operationId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // ========================================
    // RECIPE VERSIONS (User-Scoped)
    // ========================================
    match /users/{userId}/recipeVersions/{versionId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ========================================
    // SHARES (Top-Level)
    // ========================================
    match /shares/{shareId} {
      // Anyone with link can read (for accepting shares)
      allow read: if isAuthenticated();

      // Only owner can create shares
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId;

      // ANY authenticated user can update shares (for accepting)
      // This allows recipients to add themselves to acceptedBy array
      allow update: if isAuthenticated();

      // Only owner can delete
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // USER LINEAGES (User-Scoped)
    // ========================================
    match /users/{userId}/lineages/{lineageId} {
      // Users can read their own lineages
      allow read: if isOwner(userId);

      // Users can write their own lineages
      allow write: if isOwner(userId);
    }

    // ========================================
    // LINEAGES INDEX (Top-Level - for querying across users)
    // ========================================
    match /lineages/{lineageId} {
      // Any authenticated user can read (for querying family trees)
      allow read: if isAuthenticated();

      // Only owner can create lineages
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId;

      // Only owner can update lineages
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;

      // Only owner can delete lineages
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // USER NOTIFICATIONS
    // ========================================
    match /users/{userId}/notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(userId);

      // Any authenticated user can create notifications (for lineage tracking)
      // This allows descendants to notify ancestors of modifications
      allow create: if isAuthenticated();

      // Users can update their own (mark as read)
      allow update: if isOwner(userId);

      // Users can delete their own notifications
      allow delete: if isOwner(userId);
    }

    // ========================================
    // HERITAGE UNLOCK STATE (User-Scoped)
    // ========================================
    match /users/{userId}/heritageState/{document=**} {
      // Users can read and write their own heritage unlock state
      // This ensures same user gets same heritage recipes across all devices
      allow read, write: if isOwner(userId);
    }

    // ========================================
    // HERITAGE UNLOCK SCHEDULES (Read-Only)
    // ========================================
    match /heritage_schedules/{scheduleId} {
      // Any authenticated user can read unlock schedules
      // These define which recipes unlock on which day
      allow read: if isAuthenticated();
      allow write: if false; // Server-only writes
    }

    // ========================================
    // HERITAGE RECIPES (Read-Only)
    // ========================================
    match /heritage_recipes/{recipeId} {
      // Any authenticated user can read heritage recipes
      // Downloaded on-demand as they unlock
      allow read: if isAuthenticated();
      allow write: if false; // Server-only writes
    }

    // ========================================
    // PUBLIC RECIPES (Phase 11: Public Discovery)
    // ========================================
    match /publicRecipes/{recipeId} {
      // Anyone can read public recipes (discovery feed)
      allow read: if true;

      // Only authenticated users can create public recipes
      // Creator must be the one creating the document
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId;

      // Only recipe owner can update
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;

      // Only recipe owner can delete (unpublish)
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // PUBLIC RECIPE REPORTS (Phase 9: Moderation)
    // ========================================
    match /publicRecipeReports/{reportId} {
      // Users can read their own reports (to check if already reported)
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.reporterId ||
                      request.auth.uid == resource.data.reviewedBy);

      // Any authenticated user can create reports
      // Reporter ID must match auth user
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.reporterId &&
                       request.resource.data.status == 'pending';

      // Only admins can update reports (for review workflow)
      // Client apps cannot update - only Cloud Functions
      allow update: if false;

      // Reports cannot be deleted (preserve audit trail)
      allow delete: if false;
    }

    // ========================================
    // FALLBACK: Deny all other access
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
