rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Import attempts - Cloud Functions only can write, users can read their own
    // Cloud Functions with Admin SDK bypass these rules entirely
    match /import_attempts/{attemptId} {
      allow create: if false; // Only Cloud Functions can create
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid);
      allow update: if false; // Only Cloud Functions can update (for feedback)
      allow delete: if false; // Never delete (analytics data)
    }

    // Site patterns - read-only for clients, writable by server
    match /site_patterns/{domain} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server can write
    }

    // Training queue - admin only
    match /training_queue/{queueId} {
      allow read, write: if false; // Admin only via Firebase console
    }

    // User feedback - writable by owner
    match /user_feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    // Short URLs - server-managed, readable by anyone
    match /short_urls/{code} {
      allow read: if true; // Public read for redirects
      allow create: if false; // Only server can create
      allow update: if false; // Only server can update (click tracking)
      allow delete: if false; // Only server can delete
    }

    // URL clicks - server-only tracking
    match /url_clicks/{clickId} {
      allow read, write: if false; // Server-only analytics data
    }
  }
}
