rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // USER RECIPES (User-Scoped)
    // ========================================
    match /users/{userId}/recipes/{recipeId} {
      // Any authenticated user can read recipes (for accepting shares)
      // Shares are access-controlled via share IDs
      allow read: if isAuthenticated();

      // Users can create their own recipes
      allow create: if isOwner(userId);

      // Users can update their own recipes
      allow update: if isOwner(userId);

      // Users can delete their own recipes
      allow delete: if isOwner(userId);

      // Ingredients subcollection
      match /ingredients/{ingredientId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Card back subcollection
      match /cardBack/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Operations subcollection (for CRDT)
      match /operations/{operationId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // ========================================
    // RECIPE VERSIONS (User-Scoped)
    // ========================================
    match /users/{userId}/recipeVersions/{versionId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ========================================
    // SHARES (Top-Level)
    // ========================================
    match /shares/{shareId} {
      // Anyone with link can read (for accepting shares)
      // Share links are meant to be shareable, so authenticated users can read
      allow read: if isAuthenticated();

      // Only owner can create shares, with proper validation
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.keys().hasAll(['shareId', 'recipeId', 'ownerId', 'ownerName']);

      // Restricted update: Owner can update all fields OR recipient can add themselves to acceptedBy
      allow update: if isAuthenticated() && (
        // Owner can update any fields
        request.auth.uid == resource.data.ownerId ||

        // Recipient can ONLY add themselves to acceptedBy array (and update related counters)
        (
          // Must not change core fields
          request.resource.data.shareId == resource.data.shareId &&
          request.resource.data.recipeId == resource.data.recipeId &&
          request.resource.data.ownerId == resource.data.ownerId &&

          // Can only add themselves to acceptedBy (not remove or add others)
          request.resource.data.acceptedBy is list &&
          request.resource.data.acceptedBy.hasAll(resource.data.acceptedBy) &&
          request.resource.data.acceptedBy.hasOnly(resource.data.acceptedBy.concat([request.auth.uid])) &&

          // Verify they're actually adding themselves (not already in list)
          !(request.auth.uid in resource.data.acceptedBy)
        )
      );

      // Only owner can delete
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // USER LINEAGES (User-Scoped)
    // ========================================
    match /users/{userId}/lineages/{lineageId} {
      // Users can read their own lineages
      allow read: if isOwner(userId);

      // Users can write their own lineages
      allow write: if isOwner(userId);
    }

    // ========================================
    // LINEAGES INDEX (Top-Level - for querying across users)
    // ========================================
    match /lineages/{lineageId} {
      // Any authenticated user can read (for querying family trees)
      allow read: if isAuthenticated();

      // Only owner can create lineages
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId;

      // Only owner can update lineages
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;

      // Only owner can delete lineages
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // USER NOTIFICATIONS
    // ========================================
    match /users/{userId}/notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(userId);

      // Any authenticated user can create notifications (for lineage tracking)
      // This allows descendants to notify ancestors of modifications
      allow create: if isAuthenticated();

      // Users can update their own (mark as read)
      allow update: if isOwner(userId);

      // Users can delete their own notifications
      allow delete: if isOwner(userId);
    }

    // ========================================
    // USER PROFILES (Top-Level)
    // ========================================
    match /userProfiles/{userId} {
      // Any authenticated user can read profiles (for display names in version history)
      // This is read-only access to displayName and email fields
      allow read: if isAuthenticated();

      // Only owner can create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Only owner can delete their profile
      allow delete: if isOwner(userId);
    }

    // ========================================
    // USER PROFILE DATA (User-Scoped Subcollection)
    // Profile data stored under users collection
    // ========================================
    match /users/{userId}/profile/{document=**} {
      // Any authenticated user can read (for social features)
      allow read: if isAuthenticated();

      // Only owner can write their profile data
      allow write: if isOwner(userId);
    }

    // ========================================
    // USER COLLECTIONS (User-Scoped)
    // ========================================
    match /users/{userId}/collections/{collectionId} {
      // Users can read their own collections
      allow read: if isOwner(userId);

      // Users can write their own collections
      allow write: if isOwner(userId);
    }

    // ========================================
    // USER CONNECTIONS (User-Scoped)
    // Social connections, friend requests, and blocking
    // ========================================
    match /users/{userId}/connections/{connectionId} {
      // Users can read their own connections (includes pending requests)
      // Users can also query to check if blocked (checkIfBlocked function)
      allow get: if isOwner(userId);
      allow list: if isOwner(userId) || (isAuthenticated() && request.query.limit <= 10);

      // Users can create connections for themselves OR when sending a request to another user
      // When sending a friend request, both users get a connection document
      allow create: if isAuthenticated() && (
        // Creating own connection
        isOwner(userId) ||
        // Creating connection request for another user (bidirectional friend request)
        request.resource.data.initiatedBy == request.auth.uid
      );

      // Users can update their own connections (accept, reject, favorite, notes)
      // OR update connections where they are the connectedUserId (reciprocal accept)
      allow update: if isOwner(userId) || request.auth.uid == resource.data.connectedUserId;

      // Users can delete their own connections (unfriend, reject, unblock)
      // OR delete connections where they are the connectedUserId (reciprocal delete)
      allow delete: if isOwner(userId) || request.auth.uid == resource.data.connectedUserId;
    }

    // ========================================
    // THEME STATE (User-Scoped)
    // Tracks user theme selection and unlock progress
    // ========================================
    match /users/{userId}/themeState/{document=**} {
      // Users can read their own theme state
      allow read: if isOwner(userId);

      // Users can write their own theme state
      allow write: if isOwner(userId);
    }

    // ========================================
    // HERITAGE STATE (User-Scoped - Legacy)
    // Legacy path from blind box system, kept for backward compatibility
    // Current unlock system uses local SwiftData (ThemeUnlockTracker)
    // ========================================
    match /users/{userId}/heritageState/{document=**} {
      // Users can read their own heritage state
      allow read: if isOwner(userId);

      // Users can write their own heritage state
      allow write: if isOwner(userId);
    }

    // ========================================
    // THEMES (Top-Level - Read-Only)
    // Curated recipe themes for discovery
    // ========================================
    match /themes/{themeId} {
      // Any authenticated user can read themes
      allow read: if isAuthenticated();

      // Only admins can write (via Firebase console/functions)
      allow write: if false;

      // Theme recipes (subcollection)
      match /recipes/{recipeId} {
        // Any authenticated user can read theme recipes
        allow read: if isAuthenticated();

        // Only admins can write
        allow write: if false;

        // Ingredients subcollection
        match /ingredients/{ingredientId} {
          allow read: if isAuthenticated();
          allow write: if false;
        }

        // Instructions subcollection
        match /instructions/{instructionId} {
          allow read: if isAuthenticated();
          allow write: if false;
        }
      }
    }

    // ========================================
    // PUBLIC RECIPES (Top-Level)
    // Published recipes for public discovery
    // ========================================
    match /publicRecipes/{publicRecipeId} {
      // Anyone authenticated can read public recipes
      allow read: if isAuthenticated();

      // Only owner can create public recipes
      // Note: Required fields match PublicRecipe.toFirestoreData()
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.keys().hasAll([
                         'sourceRecipeId', 'ownerId', 'title',
                         'ingredients', 'tags', 'creatorName',
                         'viewCount', 'saveCount', 'searchKeywords',
                         'publishedAt', 'updatedAt'
                       ]);

      // Only owner can delete their published recipes
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;

      // Allow updates for view counts, saves, and reports (from Cloud Functions)
      // Users can also update their own recipes
      allow update: if isAuthenticated() && (
        // Owner can update their recipe
        request.auth.uid == resource.data.ownerId ||
        // OR: Allow incrementing viewCount/saveCount (these come from Cloud Functions)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'saveCount', 'reportCount', 'updatedAt']))
      );
    }

    // ========================================
    // FALLBACK: Deny all other access
    // ========================================
    // Note: rateLimits, aiUsage, userCosts are managed by Cloud Functions
    // and are not explicitly defined here. They fall through to this catch-all
    // which blocks client access. Admin SDK bypasses these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
