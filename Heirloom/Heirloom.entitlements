<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.matthanson.heirloom</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.matthanson.heirloom</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.matthanson.heirloom.shared</string>
	</array>
	<!--
	UNIVERSAL LINKS (for future use)
	Uncomment when ready to switch from CloudKit share URLs to universal links
	Requires:
	1. Apple Developer account configuration for associated domains
	2. Deploy apple-app-site-association file to heirloom.app/.well-known/
	3. Backend service to map short URLs to CloudKit share URLs
	-->
	<!--
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:heirloom.app</string>
		<string>applinks:www.heirloom.app</string>
	</array>
	-->
</dict>
</plist>
