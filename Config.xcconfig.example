// Heirloom Configuration Template
// Copy this file to Config.xcconfig and replace placeholder values with your actual API keys
// DO NOT commit Config.xcconfig to version control

// SETUP INSTRUCTIONS:
// 1. Copy this file: cp Config.xcconfig.example Config.xcconfig
// 2. Replace YOUR_*_API_KEY_HERE with your actual API keys
// 3. Never commit Config.xcconfig to git (already in .gitignore)

// Default Anthropic API Key
// Get your API key from: https://console.anthropic.com/settings/keys
// This key is shared across all users who haven't added their own key
// Format: sk-ant-api03-...
DEFAULT_ANTHROPIC_KEY = YOUR_ANTHROPIC_API_KEY_HERE

// Default OpenAI API Key
// Get your API key from: https://platform.openai.com/api-keys
// This key is used for DALL-E image generation
// Format: sk-proj-...
DEFAULT_OPENAI_KEY = YOUR_OPENAI_API_KEY_HERE

// Google Sign-In Configuration
// REVERSED_CLIENT_ID is obtained from GoogleService-Info.plist
// Find this in Firebase Console -> Project Settings -> Download GoogleService-Info.plist
// Look for the REVERSED_CLIENT_ID value in that file
// Format: com.googleusercontent.apps.XXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
REVERSED_CLIENT_ID = YOUR_REVERSED_CLIENT_ID_HERE

// Mixpanel Analytics Configuration (Optional)
// Get your tokens from: https://mixpanel.com/settings/project
// Create two projects: "Heirloom Production" and "Heirloom Development"
// The app will work without Mixpanel (falls back to console logging)
MIXPANEL_PRODUCTION_TOKEN = YOUR_MIXPANEL_PRODUCTION_TOKEN_HERE
MIXPANEL_DEVELOPMENT_TOKEN = YOUR_MIXPANEL_DEVELOPMENT_TOKEN_HERE
